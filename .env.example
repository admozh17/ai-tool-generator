# Copy to .env for local (non-docker) development.
# For docker-compose, these are set in docker-compose.yml instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_tool_generator?schema=public"
JWT_SECRET="dev-insecure-jwt-secret-change-me"

# Optional: enable real LLM-backed generation. Leave empty to use the
# deterministic rule-based composer (constrained to the same registry).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Base URL the app uses to reach its own mocked /risk-score second source.
RISK_SERVICE_BASE_URL="http://localhost:3000"
